# ---- Data ----
# Raw OpenAlex pulls are large and re-creatable from the pipeline — do not commit.
data/raw/*
!data/raw/.gitkeep

# Processed layers are build artifacts — re-created by the pipeline.
data/processed/*
!data/processed/.gitkeep

# NOTE: data/external/ IS committed on purpose.
# SCImago SJR and the Scopus source list block automated download, so they are
# fetched by hand once and committed (with download dates in docs/data_dictionary.md).

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# ---- Jupyter ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ---- Tooling / caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipython/

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# ---- Secrets / local config ----
.env
*.local
